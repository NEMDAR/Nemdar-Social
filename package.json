{
  "name": "nemdar-social",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "python3 -m server.app",
    "test": "node --test tests/*.test.js && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:js": "node --test tests/*.test.js",
    "test:server": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "worker": "python3 -m server.worker"
  }
}
